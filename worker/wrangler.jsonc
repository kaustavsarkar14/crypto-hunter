{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-hunter-copilot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Comma-separated list of front-end origins allowed to call the Worker.
    "ALLOWED_ORIGINS": "http://localhost:5173,https://crypto-hunter-three.vercel.app"
  },
  // 10 chat requests per minute per IP — protects the Anthropic bill.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
