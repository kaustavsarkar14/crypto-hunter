# URL of the deployed Cloudflare Worker (copilot + cached market-data proxy).
# Leave empty in development: /api/chat is proxied to `npm run dev:worker`,
# and market data is fetched straight from CoinGecko.
VITE_API_URL=

# Optional CoinGecko demo key, only used when VITE_API_URL is empty.
VITE_COINGECKO_API_KEY=
