# Frontend (all optional)
# Only needed if the API lives on a different domain (e.g. the Cloudflare Worker).
# On Vercel the API is same-origin at /api, so leave this empty.
VITE_API_URL=
# CoinGecko demo key used only by the direct-to-CoinGecko fallback (it ends up in the
# public bundle, so prefer COINGECKO_API_KEY on the server instead).
VITE_COINGECKO_API_KEY=

# Server-side (set these in Vercel → Settings → Environment Variables)
# GROQ_API_KEY=gsk_...         copilot (free at console.groq.com)
# COINGECKO_API_KEY=...        higher CoinGecko limits for /api/market and copilot tools
# ANTHROPIC_API_KEY=...        optional: use Claude instead of Groq
# LLM_PROVIDER=groq|claude     optional: force a provider
# ALLOWED_ORIGINS=https://...  optional: extra origins allowed to call /api
